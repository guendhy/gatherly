# =============================================================================
# Gatherly — environment variables
# Copy to .env.local for local development (never commit .env.local).
# In Vercel: Project → Settings → Environment Variables (Production + Preview).
# Generate SESSION_SECRET and TOKEN_ENCRYPTION_KEY with:  npm run gen:secrets
# =============================================================================

# --- App URL -----------------------------------------------------------------
# REQUIRED in production. The public HTTPS origin, no trailing slash.
# Used for QR links and the Google OAuth redirect. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Supabase (Project Settings → API) ---------------------------------------
# REQUIRED. Project URL and the anon / publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED, SERVER ONLY. service_role / secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that are promoted to admin the first time they sign in
# (the Supabase user must already exist and have a confirmed email).
ADMIN_EMAILS=you@example.com

# --- Secrets -----------------------------------------------------------------
# REQUIRED. 32+ random characters. Signs guest sessions and the OAuth state.
# Rotating it signs every guest out (they just re-scan the QR).
SESSION_SECRET=
# REQUIRED. 32 random bytes as base64 (44 chars) or hex (64 chars), or any
# random passphrase of 40+ characters (handy when setting up from a phone).
# Encrypts Google tokens and QR tokens at rest. Rotating it means you must
# reconnect Google Drive and regenerate every event QR code.
TOKEN_ENCRYPTION_KEY=

# --- Google Drive OAuth (Google Cloud Console → APIs & Services → Credentials)
# REQUIRED for uploads. Web-application OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to  ${NEXT_PUBLIC_APP_URL}/api/admin/google/callback
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=
# Optional. "file" (default, recommended) = Gatherly can only see files and
# folders it creates. "full" = full Drive access; needed only if you want to
# upload into a folder you created yourself (GOOGLE_DRIVE_FOLDER_ID below).
GOOGLE_DRIVE_SCOPE=file
# Optional. Parent folder for per-event folders. Only usable with
# GOOGLE_DRIVE_SCOPE=full. Leave blank and Gatherly creates "Gatherly Events".
GOOGLE_DRIVE_FOLDER_ID=

# Legacy (v1) fallback. If no Google account is connected in /admin/settings,
# Gatherly will use this refresh token instead. Prefer the in-app connect flow.
GOOGLE_REFRESH_TOKEN=

# --- Tuning (optional) -------------------------------------------------------
# Max photo upload size in MB. Vercel functions accept ~4.5 MB request bodies,
# so keep this at 4 or below there. Photos are compressed in the browser first.
UPLOAD_MAX_MB=4
# How long a guest stays signed in to an event after scanning the QR.
GUEST_SESSION_HOURS=12
